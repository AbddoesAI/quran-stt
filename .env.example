# =============================================================================
# Islamic STT — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Sunnah.com API (required for Hadith matching) ---
# Get a free key at: https://sunnah.com/developers
SUNNAH_API_KEY=

# --- Device configuration (optional, CLI flags take precedence) ---
# STT_DEVICE=cuda          # cuda | cpu
# STT_COMPUTE_TYPE=float16 # float16 | int8 | int8_float16 | float32
# STT_MODEL=large-v3       # tiny | base | small | medium | large-v3
# STT_PRIMARY_LANGUAGE=ur  # ur | ar | en | auto

# --- Hadith cache path (optional) ---
# HADITH_CACHE_PATH=cache/hadith_cache.db
